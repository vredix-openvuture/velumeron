# Device-specific, written by the installer on the machine it runs on.
hypr.lua/user_settings.lua

# Written by wallust on every wallpaper change; it kept showing machine-specific
# churn. hyprland.lua loads it through a guarded _try_dofile and
# welcome_to_velumeron.sh regenerates it, so a missing file is not a broken start.
hypr.lua/colors.lua

# Editor, agent and internal notes
.vscode/
.claude/
CLAUDE.md
claude-important.md
.internal/

# Image editor backups
assets/icons/.*.png

# Wallpapers stay local: large, and per-user content. The three branded ones ship,
# and welcome_to_velumeron.sh sets one of them on a first run. `dir/*` instead of
# `dir/` because git cannot re-include a file below an excluded directory.
assets/wallpaper/*
!assets/wallpaper/horizontal/
assets/wallpaper/horizontal/*
!assets/wallpaper/horizontal/velumeron-*.jpg
# Per-client now, stored in ~/.config/velumeron/assets/sets.json
assets/wallpaper/sets.json

# Compiled QML plugin: CMake build tree and the generated module output.
# Source lives in quickshell/plugins/<name>/; build-mpv-plugin.sh rebuilds the
# .so on demand from launch-quickshell.sh.
quickshell/plugins/*/build/
quickshell/plugins/Velumeron/

# The trailer pipeline's renders and captures. Multi-gigabyte, regenerated.
brag-output/

# Logs, caches, archives
**/*.log
**/.cache/
__pycache__/
.archive/

# Screenshots and xcursorgen intermediates land in the root during development
# and have twice been committed by accident.
/*.png
/*.conf
