{
  "id": "console",
  "name": "Console",
  "author": "velumeron",
  "version": 1,
  "contract": 1,
  "base": "straight",
  "transitions": [
    "cut",
    "wipe",
    "flicker",
    "push"
  ],
  "tokens": {
    "rCard": 0,
    "rControl": 0,
    "rTile": 0,
    "cardGap": 12,
    "cardPad": 14,
    "rowGap": 8,
    "cardFill": {
      "base": "bgPrimary",
      "alpha": 0.72
    },
    "cardBorderW": 1,
    "cardBorderColor": {
      "base": "accent",
      "alpha": 0.45
    },
    "controlFill": {
      "base": "accent",
      "lift": 0.06
    },
    "controlHover": {
      "base": "accent",
      "lift": 0.18
    },
    "controlBorderW": 1,
    "controlBorderColor": {
      "base": "accent",
      "alpha": 0.3
    },
    "selFill": {
      "base": "accent",
      "alpha": 0.26
    },
    "selText": "accent",
    "selBorderW": 1,
    "selBorderColor": "accent"
  },
  "components": {
    "lock": "components/Lock.qml",
    "backdrop": "components/Backdrop.qml",
    "material": "components/Material.qml",
    "launcher": "components/Launcher.qml",
    "notifications": "components/Notifications.qml",
    "dashboard": "components/Dashboard.qml",
    "osd": "components/Osd.qml",
    "screensaver": "components/Screensaver.qml",
    "splash": "components/Splash.qml",
    "switcher": "components/Switcher.qml",
    "zones": "components/Zones.qml",
    "skin": "components/Skin.qml",
    "wallpaper": "components/Wallpaper.qml",
    "dim": "components/Dim.qml"
  },
  "lock": {
    "layout": "instrument",
    "reveal": "bubble",
    "blur": 0.0,
    "dim": 0.0,
    "clockFormat": "hh:mm",
    "dateFormat": "dddd, dd MMMM",
    "widgets": {
      "media": "bottom-left",
      "weather": "bottom-left",
      "battery": "bottom-left",
      "notifs": "bottom-left",
      "user": "off",
      "session": "off"
    }
  },
  "settings": [
    {
      "key": "console",
      "title": "Console",
      "page": "settings/ConsoleSection.qml"
    }
  ],
  "arrangement": {
    "ui_style": "straight",
    "ui_font": "Chivo Mono",
    "bar_inner_radius": 0,
    "bar_opacity_enabled": true,
    "bar_opacity_value": 0.96,
    "colorful_enabled": false,
    "colorful_menus": false,
    "colorful_osd": false,
    "opacity_enabled": true,
    "opacity_value": 0.97,
    "settings_float": true,
    "settings_nav_mode": "page",
    "launcher_fullscreen": true,
    "launcher_dock": false,
    "notify_position": "bottom-left",
    "notify_dock": true,
    "osd_style": "dock",
    "osd_position": "top-center",
    "taskbar_enabled": false,
    "transition_style_bar": "straight",
    "transition_style_edge": "straight",
    "wallpaper_transition": "theme"
  }
}
