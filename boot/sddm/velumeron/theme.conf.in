# theme.conf — the palette Main.qml reads through sddm's `config` context property.
# Generated by boot-theme.py from the fixed Velumeron brand colours (see BRAND
# there); edit the .in template, not the copy under ~/.config/velumeron/boot/.
[General]
bg=@bg@
bg2=@bg2@
element=@element@
accent=@accent@
glow=@glow@
border=@border@
fg=@fg@
muted=@muted@
bright=@bright@
urgent=@urgent@
background=background.png
logo=logo.png
