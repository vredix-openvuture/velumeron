{
  "id": "vitrine",
  "name": "Vitrine",
  "author": "velumeron",
  "builtin": true,
  "version": 1,
  "settings": {
    "lock_layout": "band",
    "lock_reveal": "bubble",
    "lock_blur": 0.25,
    "lock_dim": 0.12,
    "lock_card_wallpaper": true,
    "lock_card_avatar": true,
    "lock_uniform_wallpaper": false,
    "lock_widget_zones": {
      "media": "bottom-left",
      "notifs": "bottom-center",
      "weather": "bottom-center",
      "battery": "bottom-right",
      "user": "off",
      "session": "off"
    },
    "lock_card_pos": "center",
    "lock_card_width_pct": 40,
    "lock_card_height_pct": 40,
    "lock_weather_forecast": false,
    "lock_weather_forecast_days": 3,
    "lock_clock_format": "hh:mm",
    "lock_date_format": "dddd, dd MMMM",
    "lock_clock_scale": 100,
    "lock_clock_style": "light",
    "lock_blur_target": "background"
  }
}
