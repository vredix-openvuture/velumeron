# Velumeron — ghostty.
#
# GENERATED. The keys here are shipped with velumeron; the colour block below is rendered from the
# live wallust palette on every theme change. Your own config was moved to config.velumeron-bak
# when you switched this on and comes back byte-for-byte when you switch it off
# (Settings → Integrations → Terminal).

window-padding-x = 8
window-padding-y = 8
background-opacity = 0.86
background-blur-radius = 20
confirm-close-surface = false
cursor-style = block
cursor-style-blink = true

@VELUMERON_COLORS@
